     {
-        $cacheId = 'workspace-service-available-workspaces' . ($includeWorkspaceData ? '-detailed' : '');
+        // Include user UID in the cache key to prevent cross-user
+        // permission leakage when the runtime cache survives across requests.
+        $cacheId = 'workspace-service-available-workspaces-' . (int)($this->getBackendUser()->user['uid'] ?? 0) . ($includeWorkspaceData ? '-detailed' : '');
         $cached = $this->runtimeCache->get($cacheId);
